# Copier ce fichier en backend/.env et renseigner les vraies valeurs.
# Ne jamais versionner backend/.env.
DB_URL=jdbc:postgresql://localhost:5432/soprahr_interne
DB_USERNAME=postgres
DB_PASSWORD=0000
# Générer : openssl rand -base64 48   (32 octets minimum une fois décodé)
JWT_SECRET=7a4YzPxqlPwSlC57o5KlanW6VORgGCTrxJnn8wt0pTiYiJuwgalizL7BOnT+FAaw #change_me_with_a_long_random_base64_secret
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=8080
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Premier administrateur : créé au démarrage s'il n'existe pas (à renseigner dans backend/.env uniquement,
# puis à retirer après la première connexion).
#BOOTSTRAP_ADMIN_EMAIL=admin@votre-domaine.tld
#BOOTSTRAP_ADMIN_PASSWORD=
